# ===== BẮT BUỘC =====
ANTHROPIC_API_KEY=sk-ant-...
# Model Claude (đổi nếu muốn, ví dụ claude-haiku-5-5 để rẻ hơn)
CLAUDE_MODEL=claude-sonnet-5-5

# ===== TELEGRAM (bỏ trống nếu không dùng) =====
TELEGRAM_BOT_TOKEN=
# ID nhóm cộng đồng để bot đăng truyện (số âm, lấy bằng lệnh /id trong nhóm)
TELEGRAM_COMMUNITY_CHAT_ID=
# ID chat của admin (hoặc nhóm admin) để bot báo khi cần người thật vào hỗ trợ
TELEGRAM_ADMIN_CHAT_ID=

# ===== DISCORD (bỏ trống nếu không dùng) =====
DISCORD_BOT_TOKEN=
# Kênh đăng truyện hằng ngày
DISCORD_STORY_CHANNEL_ID=
# Kênh chào thành viên mới
DISCORD_WELCOME_CHANNEL_ID=
# Các kênh bot tự trả lời mọi tin nhắn (cách nhau bằng dấu phẩy). Kênh khác chỉ trả lời khi được @mention
DISCORD_SUPPORT_CHANNEL_IDS=
# Kênh riêng cho admin nhận thông báo "cần người thật"
DISCORD_ADMIN_CHANNEL_ID=

# ===== TÙY CHỌN =====
# Giá trị khởi tạo cho truyện hằng ngày; sau đó chỉnh trong trang admin
STORY_ENABLED=true
STORY_HOUR=19
# auto = tự đăng | approve = tạo bản nháp, chờ admin duyệt (khuyên dùng lúc mới chạy)
STORY_MODE=approve
TIMEZONE=Asia/Ho_Chi_Minh
# Mỗi người tối đa bao nhiêu tin/phút
RATE_LIMIT_PER_MIN=6
# Nhật ký hội thoại tự xoá sau bao nhiêu ngày
LOG_RETENTION_DAYS=30

# ===== TRANG ADMIN (bỏ trống ADMIN_PASSWORD = tắt) =====
# Mật khẩu dài, khó đoán, tối thiểu 8 ký tự
ADMIN_PASSWORD=
# Mặc định chỉ mở trên máy chủ (127.0.0.1). Trong Docker đặt 0.0.0.0 và map cổng 127.0.0.1:8080:8080
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8080
# Địa chỉ công khai của trang admin, dùng để gắn link trong tin báo admin (tuỳ chọn)
ADMIN_PUBLIC_URL=
# Đặt true khi truy cập qua HTTPS (nginx/caddy) để cookie chỉ gửi qua HTTPS
ADMIN_COOKIE_SECURE=false
# Đặt true khi đứng sau reverse proxy để giới hạn đăng nhập theo IP thật
ADMIN_BEHIND_PROXY=false
# Khoá ký cookie (tuỳ chọn, bỏ trống thì suy ra từ mật khẩu)
ADMIN_SECRET=
# Nơi lưu database, kiến thức, bản sao lưu (mặc định thư mục data/)
DATA_DIR=
